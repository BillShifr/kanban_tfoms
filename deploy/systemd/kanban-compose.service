[Unit]
Description=Minimal Kanban rootless Podman Compose stack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/apps/minimal-kanban
ExecStartPre=/bin/sh -c '/usr/bin/podman compose --env-file %h/.config/kanban/api.env -f compose.prod.yml config >/dev/null'
ExecStart=/usr/bin/podman compose --env-file %h/.config/kanban/api.env -f compose.prod.yml up -d
ExecStop=/usr/bin/podman compose --env-file %h/.config/kanban/api.env -f compose.prod.yml down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
