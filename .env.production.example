# Copy outside the repository (for example, ~/.config/kanban/api.env) and chmod 600 it.
# Generate one URL-safe value with: openssl rand -hex 32
# Use that same value for POSTGRES_PASSWORD and in DATABASE_URL.
ENV_FILE=/home/vladislav/.config/kanban/api.env
IMAGE_TAG=2026.10.01
KANBAN_WEB_PORT=8080
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_PASSWORD
DATABASE_URL=postgresql://kanban:REPLACE_WITH_64_HEX_PASSWORD@db:5432/kanban?sslmode=disable
ALLOW_INSECURE_HTTP=true
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://kanban.tfoms
INITIAL_ADMIN_EMAIL=admin@kanban.tfoms
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
UPLOADS_DIR=/home/vladislav/apps/minimal-kanban-data/uploads
PUBLIC_URL=http://kanban.tfoms
BACKUP_DIR=/home/vladislav/backups/minimal-kanban
